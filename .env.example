# Copie para .env (no PythonAnywhere, na pasta do projeto) e preencha. O .env NÃO vai para o Git.

# --- Resultados e jogos automáticos (football-data.org, plano grátis) ---
# Cadastro: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# Token secreto do endpoint de cron externo: /palpites/api/sincronizar/<token>/
# (sem esta variável o endpoint fica desligado). Gere algo longo e aleatório.
SYNC_SECRET_TOKEN=

# --- Notícias do feed (opcional) ---
# Use {q} onde entra a busca. Padrão: Google Notícias filtrando o ge.globo.com.
# NOTICIAS_RSS_URL=https://news.google.com/rss/search?q={q}&hl=pt-BR&gl=BR&ceid=BR:pt-419

# --- Modo Carreira (já existentes) ---
GEMINI_API_KEY=
CRON_SECRET_TOKEN=
